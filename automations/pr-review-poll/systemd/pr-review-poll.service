[Unit]
Description=Start Claude Code reviews for pull requests requested in Slack
Documentation=https://github.com/0xmichalis/agent-rules/tree/main/automations/pr-review-poll
ConditionPathExists=%h/.config/pr-review-poll/env

[Service]
Type=oneshot
EnvironmentFile=%h/.config/pr-review-poll/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.agents/agent-rules/automations/pr-review-poll/pr_review_poll.py run
TimeoutStartSec=10min
